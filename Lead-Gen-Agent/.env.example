# Copy to .env and edit. Nothing here is required to boot.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Where the SQLite file lives. Created automatically.
DB_FILE=./database/data/leadgen.db

# The master switch.
#   true  -> channels log a fake send, nothing leaves the machine
#   false -> channels POST to the n8n webhooks below
DRY_RUN=true

# --- n8n: outbound (we call n8n) -------------------------------------
# Either set the base and let each channel append its own path...
N8N_WEBHOOK_URL=
# ...or point each channel somewhere specific. These win if set.
N8N_WEBHOOK_EMAIL=
N8N_WEBHOOK_SMS=
N8N_WEBHOOK_WHATSAPP=
N8N_TIMEOUT_MS=10000

# --- n8n: inbound (n8n calls us) -------------------------------------
# Shared secret. n8n must send it as the x-webhook-secret header.
N8N_INBOUND_SECRET=

# --- campaign defaults ------------------------------------------------
DEFAULT_DAILY_CAP=50
CAMPAIGN_BATCH_SIZE=25
